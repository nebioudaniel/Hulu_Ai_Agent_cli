# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string used by the relay.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5433/DBNAME?sslmode=disable

# Address the relay listens on. Default is 127.0.0.1:8080 (local only).
RELAY_ADDR=127.0.0.1:8080

# How long a login session token stays valid. Default 12h.
SESSION_TTL=12h

# How long a one-time WebSocket ticket stays valid. Default 30s.
TICKET_TTL=30s

# Comma-separated list of allowed browser origins for the WebSocket.
# Empty means only non-browser clients (no Origin header) may connect.
ALLOWED_ORIGINS=
